{
  "name": "a1sheet",
  "version": "0.1.0",
  "description": "Zero-dependency React spreadsheet component with Excel (XLSX) and CSV read/write, formulas, and an editable grid.",
  "keywords": [
    "react",
    "excel",
    "xlsx",
    "csv",
    "spreadsheet",
    "grid",
    "editor",
    "viewer",
    "parser",
    "formula",
    "sheet",
    "workbook",
    "ooxml"
  ],
  "license": "MIT",
  "author": "Rajat Das",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
