{
  "name": "a1sheet-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "site"
  ],
  "scripts": {
    "build": "bun run --cwd packages/a1sheet build",
    "test": "bun test",
    "typecheck": "bun run --cwd packages/a1sheet typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "bun run --cwd examples/vite-react dev",
    "storybook": "bun run --cwd examples/storybook dev",
    "storybook:build": "bun run --cwd examples/storybook build",
    "site": "bun run storybook:build && bun run --cwd site build",
    "site:smoke": "bun run --cwd site smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
