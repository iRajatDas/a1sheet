{
  "name": "a1sheet",
  "version": "0.3.5",
  "description": "React spreadsheet component with Excel (XLSX) and CSV import/export, a formula engine, and a virtualized editable grid. Zero runtime dependencies.",
  "keywords": [
    "react",
    "spreadsheet",
    "react-spreadsheet",
    "spreadsheet-component",
    "excel",
    "xlsx",
    "csv",
    "data-grid",
    "react-component",
    "excel-viewer",
    "excel-export",
    "xlsx-parser",
    "csv-parser",
    "formula",
    "formula-engine",
    "grid",
    "editor",
    "viewer",
    "parser",
    "sheet",
    "workbook",
    "ooxml",
    "zero-dependency",
    "headless",
    "typescript"
  ],
  "license": "MIT",
  "author": "Rajat Das",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iRajatDas/a1sheet.git",
    "directory": "packages/a1sheet"
  },
  "homepage": "https://irajatdas.github.io/a1sheet/",
  "bugs": "https://github.com/iRajatDas/a1sheet/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
